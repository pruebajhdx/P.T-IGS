# Application
APP_NAME="Incoming Calls API"
APP_ENV=local
APP_KEY=base64:3p8R/K2M6lB9FvXz0Y1Q4sU7wE2aC5g8hJ9lZ0c1b3A=
APP_DEBUG=true
